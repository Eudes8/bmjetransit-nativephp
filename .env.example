APP_NAME="BMJE Transit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees ---
# Local (SQLite) - pour developpement desktop
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production (Supabase PostgreSQL) - decommenter pour utiliser Supabase
# DB_CONNECTION=pgsql
# DB_HOST=db.pgghjtjqytgrpplyptwy.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=votre_mot_de_passe_supabase

# Supabase API (pour l'app mobile / realtime)
SUPABASE_URL=https://pgghjtjqytgrpplyptwy.supabase.co
SUPABASE_ANON_KEY=votre_anon_key_supabase
SUPABASE_SERVICE_KEY=votre_service_role_key_supabase

SESSION_DRIVER=file
SESSION_LIFETIME=120

# BMJE Transit Config
BMJE_NOM="BMJE Transit"
BMJE_COMMISSION=10
BMJE_LIVRAISON_BASE=1500
BMJE_LIVRAISON_KM=200
BMJE_LIVRAISON_FRAGILE=500
BMJE_VERSEMENT_MIN=5000

